{
	"name": "pi-antigravity-acp",
	"version": "0.2.1",
	"description": "Use Google Antigravity's agent (agy) in Pi over the Agent Client Protocol",
	"keywords": [
		"pi-package"
	],
	"license": "MIT",
	"files": [
		"src/",
		"README.md",
		"CHANGELOG.md",
		"LICENSE"
	],
	"engines": {
		"node": "^22.23.5 || ^24.22.3 || ^26.13.1"
	},
	"type": "module",
	"packageManager": "npm@11.20.0",
	"scripts": {
		"dev": "pi -e ./src/index.ts",
		"check": "biome ci --error-on-warnings . && tsc --noEmit",
		"lint": "biome lint --error-on-warnings .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"fix": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest watch",
		"test:coverage": "vitest run --coverage",
		"bench": "vitest bench --run --reporter=verbose",
		"audit": "npm audit --audit-level=high",
		"pack:check": "npm pack --dry-run --ignore-scripts",
		"test:package": "node scripts/smoke-package.ts",
		"verify": "npm run check && npm run test:coverage && npm run audit && npm run pack:check && npm run test:package"
	},
	"dependencies": {
		"@agentclientprotocol/sdk": "2.12.0",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@earendil-works/pi-coding-agent": "1.6.1",
		"@types/node": "22.19.19",
		"@vitest/coverage-v8": "5.1.2",
		"typebox": "1.3.27",
		"typescript": "7.0.2",
		"vitest": "5.1.2"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"pi": {
		"extensions": [
			"src/index.ts"
		]
	}
}
