{
  "name": "pi-antigravity-acp",
  "version": "0.1.0",
  "description": "Use Google Antigravity's agent (agy) in Pi over the Agent Client Protocol",
  "keywords": [
    "acp",
    "agent-client-protocol",
    "antigravity",
    "gemini",
    "pi-package"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/just-joshn/pi-google-ai-oauth.git"
  },
  "files": [
    "src"
  ],
  "type": "module",
  "module": "src/index.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix --deny-warnings",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "bun run format:check && bun run lint && bun run typecheck && bun run test:coverage",
    "bench": "vitest bench --run --reporter=verbose",
    "pack": "npm pack",
    "verify:package": "bash scripts/verify-package.sh"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.12.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "22",
    "@vitest/coverage-v8": "^5.1.1",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2008",
    "tsrs": "7.1.0-beta.tsrs5",
    "typescript": "6",
    "vitest": "^5.1.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "src/index.ts"
    ]
  }
}
